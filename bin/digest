#!/usr/bin/env bash

set -e

digest() {
  package="$1"
  version=$(echo $2 | sed 's/v//')
  arch="$3"
  url="https://github.com/fnando/$package/releases/download/v$version/$package-$arch.tar.gz"
  sha=$(wget --quiet -O - $url | shasum -a 256 | cut -f1 -d' ')

  echo "$arch: $sha"
}

if [[ "$1" == "" || "$2" == "" ]]; then
  echo "Usage: $0 BREW_NAME VERSION"
  exit 1
fi

digest "$1" "$2" aarch64-apple-darwin
digest "$1" "$2" x86_64-apple-darwin
digest "$1" "$2" x86_64-unknown-linux-gnu
digest "$1" "$2" aarch64-unknown-linux-gnu
