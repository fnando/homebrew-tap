#!/usr/bin/env ruby
# frozen_string_literal: true

# Creates a formula for a GitHub project from its latest release.
#
# Usage: bin/new [--commit] REPO
#
#   REPO      "owner/name", or just "name" for fnando/name.
#   --commit  Commit the new formula.

require_relative "../lib/tap"

PLATFORMS = {
  "aarch64-apple-darwin" => "OS.mac? && Hardware::CPU.arm?",
  "x86_64-unknown-linux-gnu" => "OS.linux? && Hardware::CPU.intel?",
  "aarch64-unknown-linux-gnu" => "OS.linux? && Hardware::CPU.arm?"
}.freeze

commit = ARGV.delete("--commit")
repo = ARGV.first

abort "Usage: #{$PROGRAM_NAME} [--commit] REPO" unless repo

repo = "fnando/#{repo}" unless repo.include?("/")
name = repo.split("/").last
path = File.join(Tap::ROOT, "#{name}.rb")

abort "#{name}.rb already exists" if File.exist?(path)

begin
  description = Tap.description(repo)
  release = Tap.latest_release(repo)
rescue StandardError => error
  abort error.message
end

version = release["tagName"].delete_prefix("v")
assets = release["assets"].map { _1["name"] }

platforms = PLATFORMS.select { |target, _| assets.include?("#{name}-#{target}.tar.gz") }

if platforms.empty?
  abort "#{repo} v#{version} has no supported assets " \
        "(expected #{name}-<target>.tar.gz for one of: #{PLATFORMS.keys.join(', ')})"
end

description = "TODO: describe this formula" if description.empty?
class_name = name.split(/[-_]/).map(&:capitalize).join

branches = platforms.each_with_index.map do |(target, condition), index|
  keyword = index.zero? ? "if" : "elsif"
  <<-RUBY.chomp
  #{keyword} #{condition}
    url "https://github.com/#{repo}/releases/download/v\#{version}/#{name}-#{target}.tar.gz"
    sha256 "0"
  RUBY
end

File.write(path, <<~RUBY)
  # frozen_string_literal: true

  class #{class_name} < Formula
  #{Tap.desc_lines(description).join.chomp}
    homepage "https://github.com/#{repo}"
    version "#{version}"

  #{branches.join("\n")}
    end

    def install
      bin.install "#{name}"
    end

    test do
      system "\#{bin}/#{name}", "--version"
    end
  end
RUBY

puts "#{name}: created #{name}.rb (#{platforms.keys.join(', ')})"

update = File.join(Tap::ROOT, "bin/update")
unless system(update, "--force", name, out: File::NULL)
  File.delete(path)
  abort "#{name}: failed to compute checksums; removed #{name}.rb"
end

if commit
  Tap.run("git", "-C", Tap::ROOT, "add", path)
  Tap.run("git", "-C", Tap::ROOT, "commit", "--quiet", "-m", "Add #{name} (#{version}).")
end

puts File.read(path)
