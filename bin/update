#!/usr/bin/env ruby
# frozen_string_literal: true

# Updates formulas to the latest GitHub release of their projects, and keeps
# their descriptions in sync with the GitHub repository description.
#
# Usage: bin/update [--force] [--commit] [FORMULA...]
#
#   --force   Recompute checksums even if the version is already the latest.
#   --commit  Create a git commit for each updated formula.
#
# Without FORMULA arguments, every *.rb file in the repo root is checked.

require "digest"
require "net/http"
require "uri"
require_relative "../lib/tap"

def sha256_for(asset)
  digest = asset["digest"].to_s
  return digest.delete_prefix("sha256:") if digest.start_with?("sha256:")

  sha256_from_download(asset["url"])
end

def sha256_from_download(url, limit = 10)
  raise "too many redirects for #{url}" if limit.zero?

  uri = URI(url)
  Net::HTTP.start(uri.host, uri.port, use_ssl: true) do |http|
    request = Net::HTTP::Get.new(uri)
    request["Accept"] = "application/octet-stream"
    http.request(request) do |response|
      case response
      when Net::HTTPRedirection
        return sha256_from_download(response["location"], limit - 1)
      when Net::HTTPSuccess
        digest = Digest::SHA256.new
        size = 0
        response.read_body do |chunk|
          size += chunk.bytesize
          digest << chunk
        end
        raise "empty download: #{url}" if size.zero?

        return digest.hexdigest
      else
        raise "download failed (#{response.code}): #{url}"
      end
    end
  end
end

# Replaces the `desc` statement (including continuation lines).
def sync_description(lines, description)
  return lines if description.empty?

  start = lines.index { _1.match?(/^\s*desc "/) }
  raise "no desc statement found" unless start

  finish = start
  finish += 1 while lines[finish].rstrip.end_with?("\\")

  lines[0...start] + Tap.desc_lines(description) + lines[(finish + 1)..]
end

def sync_release(lines, name, release)
  latest = release["tagName"].delete_prefix("v")
  assets = release["assets"].to_h { [_1["name"], _1] }
  lines = lines.dup

  lines.each_with_index do |line, index|
    if line =~ /^(\s*)version "[^"]+"/
      lines[index] = %(#{$1}version "#{latest}"\n)
    end

    next unless line =~ %r{^\s*url ".*/([^/"]+)"}

    filename = $1
    asset = assets.fetch(filename) do
      raise "release v#{latest} has no asset named #{filename}"
    end

    sha_index = index + 1
    unless lines[sha_index] =~ /^(\s*)sha256 "[0-9a-f]+"/
      raise "expected sha256 after url on line #{index + 1}"
    end

    lines[sha_index] = %(#{$1}sha256 "#{sha256_for(asset)}"\n)
  end

  lines
end

def commit_message(name, current, latest, version_changed, desc_changed, sha_changed)
  if version_changed
    "Bump up version (#{name} #{latest})"
  elsif sha_changed
    "Update checksums (#{name} #{current})"
  elsif desc_changed
    "Update description (#{name})"
  end
end

def update(path, force:, commit:)
  name = File.basename(path, ".rb")
  source = File.read(path)

  repo = source[%r{homepage "https://github\.com/([^/"]+/[^/"]+)"}, 1]
  current = source[/^\s*version "([^"]+)"/, 1]

  unless repo && current
    warn "#{name}: skipping (no GitHub homepage or version)"
    return true
  end

  lines = sync_description(source.lines, Tap.description(repo))
  desc_changed = lines.join != source

  release = Tap.latest_release(repo)
  latest = release["tagName"].delete_prefix("v")

  if Gem::Version.new(latest) < Gem::Version.new(current)
    warn "#{name}: latest release #{latest} is older than #{current}; " \
         "skipping version check"
  elsif latest != current || force
    before = lines.join
    lines = sync_release(lines, name, release)
    sha_changed = lines.join != before
  end

  updated = lines.join

  if updated == source
    puts "#{name}: up to date (#{current})"
    return true
  end

  File.write(path, updated)

  version_changed = updated[/^\s*version "([^"]+)"/, 1] != current
  changes = []
  changes << "#{current} → #{latest}" if version_changed
  changes << "checksums" if sha_changed && !version_changed
  changes << "description" if desc_changed
  puts "#{name}: updated #{changes.join(', ')}"

  if commit
    message = commit_message(
      name, current, latest, version_changed, desc_changed, sha_changed
    )
    Tap.run("git", "-C", Tap::ROOT, "add", path)
    Tap.run("git", "-C", Tap::ROOT, "commit", "--quiet", "-m", message)
  end

  true
rescue StandardError => error
  warn "#{name}: #{error.message}"
  false
end

force = ARGV.delete("--force")
commit = ARGV.delete("--commit")

paths = if ARGV.empty?
          Dir[File.join(Tap::ROOT, "*.rb")]
        else
          ARGV.map { File.join(Tap::ROOT, "#{File.basename(_1, '.rb')}.rb") }
        end

results = paths.sort.map { update(_1, force: !!force, commit: !!commit) }
exit(results.all? ? 0 : 1)
